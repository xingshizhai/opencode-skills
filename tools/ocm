#!/bin/bash
#
# ocm - OpenCode Manager
# Multi-system OpenCode skills synchronization tool
#
# Usage: ocm [command] [options]
#

set -e

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REGISTRY_DIR="${HOME}/.opencode-skills"
SKILLS_DIR="${HOME}/.opencode/skills"
HOSTNAME=$(hostname | cut -d. -f1)
MANIFEST_FILE="${REGISTRY_DIR}/manifests/${HOSTNAME}.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if registry exists
check_registry() {
    if [ ! -d "${REGISTRY_DIR}/.git" ]; then
        log_error "Registry not found at ${REGISTRY_DIR}"
        log_info "Please clone your opencode-skills repository:"
        log_info "  git clone git@github.com:xingshizhai/opencode-skills.git ~/.opencode-skills"
        exit 1
    fi
}

# Initialize manifest for current system
init_manifest() {
    mkdir -p "$(dirname "${MANIFEST_FILE}")"
    
    cat > "${MANIFEST_FILE}" << EOF
{
  "system": {
    "name": "${HOSTNAME}",
    "hostname": "$(hostname)",
    "os": "$(uname -s | tr '[:upper:]' '[:lower:]')",
    "arch": "$(uname -m)",
    "user": "$(whoami)"
  },
  "opencode": {
    "version": "1.2.10",
    "skills_path": "~/.opencode/skills"
  },
  "skills": [],
  "excluded_skills": [],
  "sync_config": {
    "auto_sync": true,
    "sync_interval_hours": 24,
    "check_updates": true
  }
}
EOF
    log_success "Created manifest: ${MANIFEST_FILE}"
}

# Generate manifest from current skills
generate_manifest() {
    log_info "Generating manifest from current skills..."
    
    # Create skills array JSON
    skills_json="["
    first=true
    
    for skill_dir in "${SKILLS_DIR}"/*/; do
        if [ -d "${skill_dir}" ]; then
            skill_name=$(basename "${skill_dir}")
            
            if [ "$first" = true ]; then
                first=false
            else
                skills_json+=","
            fi
            
            skills_json+="
    {
      \"name\": \"${skill_name}\",
      \"version\": \"1.0.0\",
      \"source\": \"local\",
      \"auto_update\": true,
      \"installed_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",
      \"updated_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"
    }"
        fi
    done
    
    skills_json+="
  ]"
    
    # Write full manifest
    cat > "${MANIFEST_FILE}" << EOF
{
  "system": {
    "name": "${HOSTNAME}",
    "hostname": "$(hostname)",
    "os": "$(uname -s | tr '[:upper:]' '[:lower:]')",
    "arch": "$(uname -m)",
    "user": "$(whoami)"
  },
  "opencode": {
    "version": "1.2.10",
    "skills_path": "~/.opencode/skills"
  },
  "skills": ${skills_json},
  "excluded_skills": [],
  "sync_config": {
    "auto_sync": true,
    "sync_interval_hours": 24,
    "check_updates": true
  }
}
EOF
    
    log_success "Manifest generated: ${MANIFEST_FILE}"
}

# Push local skills to registry
push_to_registry() {
    log_info "Pushing local skills to registry..."
    
    cd "${REGISTRY_DIR}"
    
    # Sync skills
    log_info "Syncing skills directory..."
    rsync -av --delete "${SKILLS_DIR}/" "${REGISTRY_DIR}/skills/" 2>/dev/null || true
    
    # Generate manifest
    generate_manifest
    
    # Git operations
    git add -A
    
    if git diff --cached --quiet; then
        log_info "No changes to commit"
    else
        git commit -m "Sync from ${HOSTNAME} - $(date '+%Y-%m-%d %H:%M:%S')"
        git push origin main
        log_success "Pushed to registry"
    fi
}

# Pull skills from registry
pull_from_registry() {
    log_info "Pulling skills from registry..."
    
    cd "${REGISTRY_DIR}"
    
    # Fetch latest
    git pull origin main
    
    # Sync skills to local
    if [ -d "${REGISTRY_DIR}/skills" ]; then
        log_info "Syncing skills to local..."
        rsync -av "${REGISTRY_DIR}/skills/" "${SKILLS_DIR}/"
        log_success "Skills synchronized"
    fi
}

# Two-way sync
sync_registry() {
    log_info "Synchronizing with registry..."
    pull_from_registry
    push_to_registry
    log_success "Sync complete!"
}

# List all skills
list_skills() {
    log_info "Installed skills on ${HOSTNAME}:"
    
    if [ -d "${SKILLS_DIR}" ]; then
        for skill_dir in "${SKILLS_DIR}"/*/; do
            if [ -d "${skill_dir}" ]; then
                skill_name=$(basename "${skill_dir}")
                if [ -f "${skill_dir}/SKILL.md" ]; then
                    echo "  ✓ ${skill_name}"
                else
                    echo "  ⚠ ${skill_name} (no SKILL.md)"
                fi
            fi
        done
    else
        log_warn "No skills directory found"
    fi
}

# List skills from all systems
list_all_systems() {
    log_info "Skills across all systems:"
    
    for manifest in "${REGISTRY_DIR}/manifests/"*.json; do
        if [ -f "${manifest}" ]; then
            system_name=$(basename "${manifest}" .json)
            echo ""
            echo "📱 ${system_name}:"
            
            # Parse skills from manifest (simple grep for now)
            grep -A1 '"name"' "${manifest}" | grep '"name"' | sed 's/.*"name": "\([^"]*\)".*/  - \1/' || true
        fi
    done
}

# Copy skill from another system
copy_skill() {
    local source_system="$1"
    local skill_name="$2"
    
    if [ -z "${source_system}" ] || [ -z "${skill_name}" ]; then
        log_error "Usage: ocm copy <system>:<skill>"
        exit 1
    fi
    
    log_info "Copying ${skill_name} from ${source_system}..."
    
    source_path="${REGISTRY_DIR}/skills/${skill_name}"
    dest_path="${SKILLS_DIR}/${skill_name}"
    
    if [ ! -d "${source_path}" ]; then
        log_error "Skill not found in registry: ${skill_name}"
        exit 1
    fi
    
    if [ -d "${dest_path}" ]; then
        log_warn "Skill already exists locally, updating..."
        rm -rf "${dest_path}"
    fi
    
    cp -r "${source_path}" "${dest_path}"
    log_success "Copied ${skill_name}"
    
    # Push to registry
    push_to_registry
}

# Show status
status() {
    echo "📊 OpenCode Manager Status"
    echo "=========================="
    echo ""
    echo "System: ${HOSTNAME}"
    echo "Registry: ${REGISTRY_DIR}"
    echo "Skills Dir: ${SKILLS_DIR}"
    echo ""
    
    # Check git status
    cd "${REGISTRY_DIR}"
    if git rev-parse --git-dir > /dev/null 2>>1; then
        echo "Git Status:"
        git status -s || true
        echo ""
        echo "Last commit:"
        git log -1 --oneline || true
    fi
    echo ""
    
    # List skills
    list_skills
}

# Install skill
install_skill() {
    local skill_name="$1"
    local source="$2"
    
    if [ -z "${skill_name}" ]; then
        log_error "Usage: ocm install <skill-name> [source]"
        exit 1
    fi
    
    log_info "Installing skill: ${skill_name}"
    
    # TODO: Implement installation from various sources
    # For now, just create directory structure
    mkdir -p "${SKILLS_DIR}/${skill_name}"
    
    log_success "Created skill directory: ${SKILLS_DIR}/${skill_name}"
    log_info "Please add SKILL.md and other files manually"
}

# Show help
show_help() {
    cat << EOF
OpenCode Manager (ocm) - Multi-system skills synchronization tool

Usage: ocm [command] [options]

Commands:
  init              Initialize manifest for current system
  list              List installed skills on current system
  list-all          List skills across all systems
  push              Push local skills to registry
  pull              Pull skills from registry
  sync              Two-way sync with registry
  copy <sys:skill> Copy skill from another system
  install <name>   Install a new skill (creates directory)
  status            Show status and git info
  help              Show this help message

Examples:
  ocm init                    # Initialize this system
  ocm sync                    # Sync skills with registry
  ocm copy server:linux-skill # Copy skill from 'server' system
  ocm list-all                # See all skills on all systems

Environment:
  REGISTRY_DIR: ${REGISTRY_DIR}
  SKILLS_DIR:   ${SKILLS_DIR}
EOF
}

# Main command handler
main() {
    check_registry
    
    case "${1:-help}" in
        init)
            init_manifest
            ;;
        push)
            push_to_registry
            ;;
        pull)
            pull_from_registry
            ;;
        sync)
            sync_registry
            ;;
        list)
            list_skills
            ;;
        list-all|list_all)
            list_all_systems
            ;;
        copy)
            # Parse system:skill format
            IFS=':' read -r system skill <<< "$2"
            copy_skill "$system" "$skill"
            ;;
        install)
            install_skill "$2" "$3"
            ;;
        status)
            status
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

# Run main
main "$@"
