#!/usr/bin/env python3
"""
Monitor ESP32 serial output and analyze logs.

Usage:
    monitor_serial.py [--port SERIAL_PORT] [--baud BAUD_RATE] [--path PROJECT_PATH] 
                      [--filter FILTER] [--save LOG_FILE] [--no-color] [--setup]

Examples:
    monitor_serial.py
    monitor_serial.py --port /dev/ttyUSB0 --baud 115200
    monitor_serial.py --filter "error|warn" --save debug.log
    monitor_serial.py --setup  # Run setup wizard first
"""

import os
import sys
import subprocess
import argparse
import re
import signal
import time

# Add config manager to path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import config_manager

def check_esp_idf(setup_if_needed=True):
    """Check if ESP-IDF environment is set up."""
    # Try to get configured IDF_PATH
    idf_path = config_manager.get_configured_idf_path()
    
    if not idf_path and setup_if_needed:
        print("ESP-IDF is not configured.")
        response = input("Would you like to run the setup wizard now? [Y/n]: ").strip().lower()
        if response in ['', 'y', 'yes']:
            config = config_manager.interactive_setup()
            if config:
                idf_path = config.get('idf_path')
            else:
                print("Setup cancelled.")
                return False
        else:
            print("Please configure ESP-IDF first.")
            print("Run: python scripts/config_manager.py --setup")
            return False
    
    if not idf_path:
        print("ERROR: ESP-IDF is not configured.")
        print("Please run: python scripts/config_manager.py --setup")
        return False
    
    if not os.path.exists(idf_path):
        print(f"ERROR: IDF_PATH directory does not exist: {idf_path}")
        print("Please reconfigure ESP-IDF: python scripts/config_manager.py --setup")
        return False
    
    # Check if idf.py is in PATH
    try:
        # Set IDF_PATH for child processes
        os.environ['IDF_PATH'] = idf_path
        subprocess.run(['idf.py', '--version'], capture_output=True, check=True)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("ERROR: idf.py command not found.")
        print("Please make sure ESP-IDF environment is properly sourced.")
        print(f"IDF_PATH is set to: {idf_path}")
        print("Try running: source $IDF_PATH/export.sh")
        return False

def detect_serial_port():
    """Try to detect ESP32 serial port."""
    # Common serial ports on Linux
    possible_ports = [
        "/dev/ttyUSB0", "/dev/ttyUSB1", "/dev/ttyUSB2", "/dev/ttyUSB3",
        "/dev/ttyACM0", "/dev/ttyACM1", "/dev/ttyACM2", "/dev/ttyACM3",
        "/dev/ttyS0", "/dev/ttyS1", "/dev/ttyS2", "/dev/ttyS3"
    ]
    
    # Check each port
    for port in possible_ports:
        if os.path.exists(port):
            print(f"  Detected possible serial port: {port}")
            return port
    
    # Try to find via glob pattern
    import glob
    usb_ports = glob.glob("/dev/ttyUSB*") + glob.glob("/dev/ttyACM*")
    if usb_ports:
        print(f"  Detected possible serial port: {usb_ports[0]}")
        return usb_ports[0]
    
    return None

def start_monitor(project_path, port, baud, filter_pattern, log_file, no_color, setup_if_needed=True):
    """Start serial monitor with optional filtering and logging."""
    # Load configuration for default port
    config = config_manager.load_config()
    
    # Use default port from config if not specified
    if not port and config.get('default_port'):
        port = config['default_port']
        print(f"Using default port from config: {port}")
    
    # Determine project directory
    if not project_path:
        project_path = os.getcwd()
    
    # Detect port if not specified (and not in config)
    if not port:
        port = detect_serial_port()
        if not port:
            print("ERROR: Could not detect serial port automatically.")
            print("Please specify port manually with --port option.")
            print("Common ports: /dev/ttyUSB0 (Linux), COM3 (Windows), /dev/cu.usbserial-* (macOS)")
            return False
    
    print(f"Starting ESP32 serial monitor")
    print(f"  Port: {port}")
    print(f"  Baud rate: {baud}")
    if filter_pattern:
        print(f"  Filter: {filter_pattern}")
    if log_file:
        print(f"  Log file: {log_file}")
    
    # Build monitor command
    cmd = ['idf.py', '-p', port, '-b', str(baud), 'monitor']
    
    if no_color:
        cmd.extend(['--color', 'no'])
    
    # Change to project directory if it exists
    original_dir = os.getcwd()
    if os.path.exists(project_path):
        os.chdir(project_path)
    
    try:
        
        # Handle Ctrl+C gracefully
        def signal_handler(sig, frame):
            print("\n\nSerial monitor stopped.")
            if log_file and log_handle:
                log_handle.close()
                print(f"Log saved to: {log_file}")
            sys.exit(0)
        
        signal.signal(signal.SIGINT, signal_handler)
        
        # Open log file if specified
        log_handle = None
        if log_file:
            log_handle = open(log_file, 'w')
            print(f"  Logging to: {log_file}")
        
        # Start monitor process
        print("\n" + "="*60)
        print("ESP32 Serial Monitor (Press Ctrl+] to exit)")
        print("="*60 + "\n")
        
        process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            universal_newlines=True
        )
        
        # Compile filter regex if specified
        regex = None
        if filter_pattern:
            try:
                regex = re.compile(filter_pattern, re.IGNORECASE)
            except re.error as e:
                print(f"ERROR: Invalid filter pattern: {e}")
                process.terminate()
                return False
        
        # Process output line by line
        line_count = 0
        match_count = 0
        
        if process.stdout is None:
            print("ERROR: Could not capture process output")
            process.terminate()
            return False
        
        for line in iter(process.stdout.readline, ''):
            line_count += 1
            
            # Apply filter if specified
            if regex:
                if regex.search(line):
                    match_count += 1
                    print(f"[{match_count}] {line}", end='')
                else:
                    continue
            else:
                print(line, end='')
            
            # Write to log file if specified
            if log_handle:
                log_handle.write(line)
                log_handle.flush()
        
        # Wait for process to complete
        process.wait()
        
        if log_handle:
            log_handle.close()
            print(f"\nLog saved to: {log_file}")
        
        print(f"\nMonitor stopped. Processed {line_count} lines.")
        if filter_pattern:
            print(f"Matched {match_count} lines with pattern: {filter_pattern}")
        
        return True
        
    except Exception as e:
        print(f"ERROR: Monitor failed with exception: {e}")
        return False
    finally:
        os.chdir(original_dir)

def main():
    parser = argparse.ArgumentParser(description="Monitor ESP32 serial output and analyze logs")
    parser.add_argument("--port", help="Serial port (e.g., /dev/ttyUSB0, COM3). If not specified, uses default from config or auto-detects.")
    parser.add_argument("--baud", type=int, default=115200, help="Baud rate (default: 115200)")
    parser.add_argument("--path", help="Path to project directory (default: current directory)")
    parser.add_argument("--filter", help="Filter pattern (regex) to show only matching lines")
    parser.add_argument("--save", help="Save log to file")
    parser.add_argument("--no-color", action="store_true", help="Disable color output")
    parser.add_argument("--setup", action="store_true", help="Run setup wizard before monitoring")
    
    args = parser.parse_args()
    
    # Run setup wizard if requested
    setup_if_needed = True
    if args.setup:
        config = config_manager.interactive_setup()
        if not config:
            print("Setup cancelled.")
            sys.exit(1)
        setup_if_needed = False  # Already setup
    
    # Check ESP-IDF environment
    if not check_esp_idf(setup_if_needed):
        sys.exit(1)
    
    success = start_monitor(
        args.path, 
        args.port, 
        args.baud, 
        args.filter,
        args.save,
        args.no_color,
        setup_if_needed
    )
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()